# ============================================================
# 像素农场 Online — 环境变量模板
# 使用方式: 复制为 .env 并修改配置
# ============================================================

# ---------- 应用基础配置 ----------
APP_NAME=像素农场 Online
APP_VERSION=1.0.0
DEBUG=true
# 开发模式下 CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000

# ---------- 数据库 ----------
# 开发环境: 使用 SQLite（零依赖，立即启动）
DATABASE_URL=sqlite+aiosqlite:///./pixel_farm.db
# 是否打印每条 SQL（排查问题时临时设为 true，默认关闭以减少日志与 I/O）
SQL_ECHO=false
# 生产环境: 使用 MySQL 8.0（示例）
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/pixel_farm?charset=utf8mb4
# 注意: MySQL 密码中若包含特殊字符（如 @ # : /），需进行 URL 编码

# ---------- JWT 配置 ----------
# 生产环境必须更换为随机生成的强密钥
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-32-byte-string-please
ALGORITHM=HS256
# Access Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 游戏配置 ----------
# 新玩家初始金币
INITIAL_GOLD=100
# 新玩家初始土地格子数
INITIAL_CELL_COUNT=3
# 土地最大格子数
MAX_CELL_COUNT=25
# 扩建单次费用（公式，实际值由 Admin 在商店里配置）
EXPAND_COST=500
# 作物成熟后多少秒仍未收获会枯萎（默认 24 小时 = 86400 秒）
WITHER_GRACE_SECONDS=86400

# ---------- 管理员初始账号 ----------
# 首次启动时自动创建（如果不存在）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
